---
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Panel de administración de grupos de trabajo - Hexoneira Credentials">
  <title>Super Admin | Hexoneira</title>
</head>
<body>
  <div class="main-container flex h-screen flex-col overflow-hidden text-(--white) md:flex-row">

    <!-- Sidebar: top bar en móvil, columna en desktop -->
    <aside class="shrink-0 border-b border-(--support-gunmetal) bg-(--bg-black-gunmetal) p-4 md:flex md:w-64 md:flex-col md:justify-between md:border-b-0 md:border-r md:p-6">
      <div>
        <div class="mb-4 flex items-center gap-3 md:mb-12">
          <div class="flex h-8 w-8 items-center justify-center rounded bg-(--support-gunmetal)">
            <span class="font-bold text-(--support-beer)">H</span>
          </div>
          <div class="min-w-0">
            <h1 class="text-lg font-bold tracking-widest uppercase">Hexoneira</h1>
            <p class="text-[10px] tracking-widest uppercase text-(--cyan)">Super Admin</p>
          </div>
        </div>

        <nav class="flex flex-row gap-4 text-sm font-semibold md:flex-col">
          <a href="/super-admin" class="flex items-center gap-3 border-l-2 border-(--cyan) pl-3 text-(--cyan)">
            <span>Grupos de Trabajo</span>
          </a>
          <a href="/carnet" class="flex items-center gap-3 border-l-2 border-transparent pl-3 text-(--support-grey) hover:text-(--cyan)">
            <span>Mi carnet</span>
          </a>
        </nav>
      </div>

      <div class="mt-4 flex flex-row items-center gap-4 md:mt-0 md:flex-col md:gap-6">
        <button id="btn-create-group" class="primary-button rounded-full text-xs text-(--bg-black-gunmetal) shadow-[0_0_15px_rgba(0,255,255,0.2)] transition-all hover:shadow-[0_0_25px_rgba(0,255,255,0.4)]">
          Crear Nuevo Grupo
        </button>

        <button id="btn-logout" class="text-left text-xs text-(--support-grey) transition-colors hover:text-(--support-lila)">
          Cerrar sesión
        </button>
      </div>
    </aside>

    <!-- Main content -->
    <main class="flex flex-1 flex-col overflow-y-auto bg-(--bg-eerie)">
      <header class="flex items-center justify-between border-b border-(--support-gunmetal) px-4 py-4 md:px-10 md:py-6">
        <div class="flex items-center gap-3">
          <div class="h-2 w-2 rounded-full bg-(--cyan) shadow-[0_0_6px_var(--cyan)]"></div>
          <span class="text-[10px] uppercase tracking-widest text-(--support-grey)">Panel de Administración</span>
        </div>
        <div class="flex items-center gap-4">
          <span id="header-user-info" class="hidden text-[10px] uppercase tracking-widest text-(--support-grey) sm:inline"></span>
          <button id="btn-header-logout" class="text-[10px] font-bold uppercase tracking-widest text-(--support-grey) transition-colors hover:text-(--support-lila)">
            Salir
          </button>
        </div>
      </header>

      <div class="p-4 md:p-10">
        <slot />
      </div>
    </main>
  </div>

  <script>
    import { useAuthStore } from '../store/authStore';

    // Botón crear grupo (sidebar)
    const btnCreate = document.getElementById('btn-create-group');
    if (btnCreate) {
      btnCreate.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('openCreateGroupModal'));
      });
    }

    // Logout
    const handleLogout = () => {
      useAuthStore.getState().logout();
      window.location.href = '/';
    };

    document.getElementById('btn-logout')?.addEventListener('click', handleLogout);
    document.getElementById('btn-header-logout')?.addEventListener('click', handleLogout);

    // Mostrar info del usuario en el header
    const user = useAuthStore.getState().user;
    const headerInfo = document.getElementById('header-user-info');
    if (headerInfo && user) {
      headerInfo.textContent = `Super Admin · ${user.nombre || user.name || user.id || 'Sesión activa'}`;
    }
  </script>
</body>
</html>
