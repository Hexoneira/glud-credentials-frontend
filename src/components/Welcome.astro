---
import OrbsBackground from "./OrbsBackground";
import '../styles/global.css'



import { API_BASE_URL } from '../config';

const API_AUTHLOGIN_ENDPOINT = `${API_BASE_URL}/api/auth/login`;
const API_TIMEOUT = 1200;


---
<!--Tarjeta central y orbes del fondo-->

<section id="panel" class="relative isolate grid min-h-screen grid-cols-[1.25rem_minmax(0,1fr)_1.25rem] grid-rows-[1fr_auto_1fr] overflow-hidden bg-[#050916] py-6 font-sans selection:bg-cyan-500/30 sm:grid-cols-[1rem_minmax(0,1fr)_1rem] sm:py-0 md:grid-cols-[1.25rem_minmax(0,67rem)_1.25rem] lg:grid-cols-[2fr_minmax(0,75rem)_2fr]">
    <div class="absolute inset-0 z-0">
      <OrbsBackground client:load />
    </div>
    <div class="absolute inset-0 z-0 bg-[radial-gradient(circle_at_15%_15%,rgba(34,254,251,0.1),transparent_36%),radial-gradient(circle_at_85%_85%,rgba(129,140,248,0.1),transparent_40%),linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-size-[auto,auto,28px_28px,28px_28px] opacity-40 pointer-events-none" aria-hidden="true"></div>

    <article class="credential-card relative z-20 col-start-2 row-start-2 w-full justify-self-center overflow-hidden rounded-4xl border border-cyan-400/40 shadow-[0_0_20px_rgba(34,254,251,0.15)] transition-all duration-500 ease-out hover:border-cyan-300/60 hover:shadow-[0_0_30px_rgba(34,254,251,0.3)] bg-[#0b1120]/95 backdrop-blur-2xl grid grid-cols-[0.8rem_minmax(0,1fr)_0.8rem] grid-rows-[0.7rem_minmax(0,1fr)_0.7rem] sm:grid-cols-[1rem_minmax(0,1fr)_1rem] sm:grid-rows-[0.8rem_minmax(0,1fr)_0.8rem] md:grid-cols-[1.5rem_minmax(0,1fr)_1.5rem] md:grid-rows-[1rem_minmax(0,1fr)_1rem] lg:grid-cols-[2rem_minmax(0,1fr)_2rem] lg:grid-rows-[1.2rem_minmax(0,1fr)_1.2rem]">
        <div class="card-sheen" aria-hidden="true"></div>
        <div class="absolute inset-x-0 top-0 h-px w-full bg-linear-to-r from-transparent via-cyan-400/50 to-transparent"></div>

        <div id="inner-panel" class="relative z-10 col-start-2 row-start-2 w-full grid grid-rows-[0.4rem_auto_1fr_auto_0.4rem] sm:grid-rows-[0.7rem_auto_1fr_auto_0.7rem]">
            <header class="row-start-2 grid grid-cols-[minmax(0,1fr)_auto] items-start gap-3 border-b border-white/15 p-4 sm:gap-5 sm:p-5 md:p-6 lg:p-8 sm:items-end">
                           <div class="min-w-0 text-left">
                    <h1 class="text-2xl font-black tracking-widest text-white drop-shadow-[0_0_12px_rgba(34,254,251,0.3)] sm:text-3xl md:text-5xl sm:tracking-widest md:tracking-widest">COWORKING</h1>
                    <p class="mt-1 text-[0.58rem] font-bold uppercase tracking-[0.27em] text-cyan-400 sm:text-[0.7rem] md:text-[0.75rem] sm:tracking-[0.25em] md:tracking-[0.3em]">Universidad Distrital</p>
                </div>
                <h1 class="text-white font-black tracking-wider md:text-5xl">LOGIN</h1>
            </header>
    
      <div class="row-start-3 h-px w-full bg-linear-to-r from-transparent via-cyan-400/30 to-transparent"></div>                                                                                  
 <section class="row-start-4 grid content-center gap-6 p-4 sm:p-5 md:p-6 lg:p-8"> 
   <form id="login-form" class="grid gap-4">
     <!-- Campo Usuario/Codigo -->
                      <div class="grid gap-2"> 
                          <label for="text" class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-slate-400">Usuario         
                          </label>                                                                                                                                    
                          <input 
                              type="text"
                              id="Campo"
                              name="Campo" 
                              placeholder="Nombre Asignado" 
                              required

                              class="w-full rounded-md border border-white/10 bg-[#0b1220]/90 px-4 py-3 text-white placeholder-slate-500 focus:border-cyan-400/50 focus:outline-none focus:ring-1 focus:ring-cyan-400/30 transition-all"/>                             
                      </div>

    <!----Campo Contraseña-->
    <div class="grid gap-2">
      <label for="text" class="text-[0.6rem] font-bold uppercase tracking-[0.2em] text-slate-400">Contraseña
      </label>
      <input
          type="password"
          id="number"
          name="input"
          placeholder="202xxxxxxx"
          required

          class="w-full rounded-md border border-white/10 bg-[ #0b1220]/90 px-4 py-3 text-white placeholder-slate-500 focus:border-cyan-400/50 focus:outline-none focus:ring-1 focus:ring-cyan-400/30 transition-all"/>



      









