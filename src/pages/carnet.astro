---
import Layout from '../layouts/Layout.astro';
import ProtectedRoute from '../layouts/ProtectedRoute.astro';
import CarnetPanel from '../components/carnet/CarnetPanel.astro';
import GuestManager from '../components/carnet/GuestManager';
import AttendanceQR from '../components/carnet/AttendanceQR';
import '../styles/global.css';

// Pagina del carnet del estudiante
---
<ProtectedRoute>
    <Layout>
        <button
            id="btn-carnet-logout"
            type="button"
            class="fixed right-4 top-4 z-50 rounded-full border border-white/15 bg-[#0b1120]/80 px-4 py-2 text-[10px] font-bold uppercase tracking-widest text-slate-300 backdrop-blur-sm transition-colors hover:border-(--support-lila) hover:text-(--support-lila)"
        >
            Salir
        </button>
        <CarnetPanel />
        <AttendanceQR client:load />
        <GuestManager client:load />
    </Layout>
</ProtectedRoute>

<script>
    import { useAuthStore } from '../store/authStore';

    document.getElementById('btn-carnet-logout')?.addEventListener('click', () => {
        useAuthStore.getState().logout();
        window.location.href = '/';
    });
</script>
